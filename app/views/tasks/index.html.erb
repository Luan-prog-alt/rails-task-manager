

<h1 class="mb-3">Tasks</h1>

<div class="container">
  <%= link_to "New task", new_task_path, class: "btn btn-primary mb-3" %>

  <ul class="list-group">
    <% @tasks.each do |task| %>
      <li class="list-group-item">
        <%= link_to task.title, "/tasks/#{task.id}", class: "text-decoration-none" %>
      </li>
    <% end %>
  </ul>
</div>

